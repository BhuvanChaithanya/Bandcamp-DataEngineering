# Local.terraform directories
**/.terraform/*

#.tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all.tfvars files, which are likely to contain sensitive data,
# except for the example file.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Ignore override files as they are usually used for local testing or sensitive data.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform provider plugins
.terraform.lock.hcl

# Ignore the file containing sensitive credentials
providers.tf